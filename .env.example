# ===================================================================
# BOPP EM MAINTENANCE - CẤU HÌNH HỆ THỐNG & KẾT NỐI NAS SYNOLOGY
# ===================================================================

# 1. CẤU HÌNH MÁY CHỦ WEB (UBUNTU / LINUX)
APP_HOST=0.0.0.0
APP_PORT=8000

# 2. CHẾ ĐỘ LƯU TRỮ BỘ NHỚ NAS:
# - 'sftp': Sử dụng giao thức mã hóa SFTP (SSH File Transfer Protocol) - Khuyên dùng cho Ubuntu
# - 'local': Lưu trữ tại thư mục cục bộ của máy chủ (Fallback khi chưa cấu hình NAS)
STORAGE_MODE=sftp

# 3. THÔNG TIN KẾT NỐI SFTP TỚI NAS SYNOLOGY
# Địa chỉ IP hoặc Domain nội bộ của NAS Synology
NAS_HOST=192.168.1.100

# Cổng SFTP (Mặc định Synology: 22 hoặc cổng tùy chỉnh như 2222)
NAS_PORT=22

# Tài khoản người dùng trên NAS Synology có quyền Đọc/Ghi vào Shared Folder
NAS_USERNAME=bopp_storage

# Mật khẩu tài khoản NAS (nếu sử dụng mật khẩu)
NAS_PASSWORD=YourSecurePasswordHere

# Đường dẫn tới SSH Private Key trên Ubuntu (nếu sử dụng xác thực bằng khóa SSH, để trống nếu dùng password)
# Ví dụ: /home/ubuntu/.ssh/id_rsa
NAS_KEY_PATH=

# Thư mục gốc lưu trữ trên NAS Synology (Đường dẫn tuyệt đối trong File Station của DSM)
# Ví dụ: /volume1/Maintenance_Storage hoặc /volume2/BOPP_Data
NAS_REMOTE_ROOT=/volume1/Maintenance_Storage

# Thư mục bộ đệm cục bộ (Cache) trên máy chủ Ubuntu để phản hồi nhanh cho Web
NAS_LOCAL_CACHE_DIR=./nas_storage

# 4. BẢO MẬT XÁC THỰC JWT
JWT_SECRET_KEY=bopp-maintenance-secure-jwt-key-2026-very-long-string
